{
  "name": "mpixel-video-meetings",
  "version": "0.1.0",
  "private": true,
  "description": "MPixel video meetings monorepo",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,scss,md,mdx}": "prettier --write"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run dev -w @mpixel/api\" \"npm run dev -w @mpixel/web\"",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.79",
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.4.2"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
